# Create an app at https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_keystring
ETSY_SHARED_SECRET=your_shared_secret
# Must exactly match a Callback URL registered on your Etsy app
ETSY_REDIRECT_URI=http://localhost:3000/auth/etsy/callback
# Space-separated OAuth scopes
ETSY_SCOPES=listings_r listings_w shops_r profile_r
PORT=3000
# Auto re-sync all listings every N minutes (0 = off)
SYNC_INTERVAL_MINUTES=60

# OpenAI (ChatGPT), used to translate listings. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# Optional: which OpenAI model to use
OPENAI_MODEL=gpt-5.5
# Wait between OpenAI requests in milliseconds (requests always run one at a time)
OPENAI_DELAY_MS=1000
