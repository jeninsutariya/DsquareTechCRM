# Create an app at https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_keystring
ETSY_SHARED_SECRET=your_shared_secret
# Must exactly match a Callback URL registered on your Etsy app
ETSY_REDIRECT_URI=http://localhost:3000/auth/etsy/callback
# Space-separated OAuth scopes
ETSY_SCOPES=listings_r listings_w shops_r profile_r
PORT=3000
# Auto re-sync all listings every N minutes (0 = off)
SYNC_INTERVAL_MINUTES=60

# ---- Translation ----
# Gemini API keys (get them at https://aistudio.google.com/apikey). Add up to 5 (or more).
# Order used: key 1 with every model below, then key 2 with every model, and so on.
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Gemini models in the order they are tried; when one hits its limit the next is used.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash,gemini-3-flash,gemini-3.7-flash,gemini-3.8-flash

# Wait between AI requests in milliseconds (requests always run one at a time)
TRANSLATE_DELAY_MS=1000
